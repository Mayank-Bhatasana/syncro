# Copy this file to server/.env and adjust the values for your machine.

PORT=4000

# PostgreSQL (docker compose up -d starts it on port 5433)
DATABASE_URL="postgresql://syncro:syncro_password@localhost:5433/syncro_db?schema=public"

# Redis (docker compose up -d starts it on port 6380)
REDIS_URL="redis://localhost:6380"

# Secret used to sign login tokens. Use a long random string outside local development.
JWT_SECRET=change-me-to-a-long-random-string

# Where the web app runs (used for CORS and sockets)
CLIENT_URL="http://localhost:3000"

# Timezone the company works in. Leave, breaks and bookings are judged on these days.
# Defaults to the machine's timezone. Example: Asia/Kolkata, Europe/London, America/New_York
COMPANY_TIMEZONE="Asia/Kolkata"
